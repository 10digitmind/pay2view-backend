<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Withdrawal Processed</title>
  </head>
  <body style="margin:0; padding:0; background-color:#f5f5f5; font-family: Arial, sans-serif;">
    <table width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#f5f5f5; padding:20px 0;">
      <tr>
        <td align="center">
          <table width="600" cellpadding="0" cellspacing="0" border="0"
                 style="background-color:#ffffff; border-radius:8px; overflow:hidden; border:1px solid #e6e6e6;">
            
            <!-- Header -->
            <tr>
              <td align="center" bgcolor="#0b3d91" style="color:#ffffff; padding:20px; font-size:20px; font-weight:600;">
                Withdrawal Successfully Processed
              </td>
            </tr>
            
            <!-- Body -->
            <tr>
              <td style="padding:28px 32px; color:#333333; font-size:15px; line-height:1.6;">
                <p style="margin:0 0 14px 0;">Hello <strong>{{name}}</strong>,</p>

                <p style="margin:0 0 14px 0;">
                  We have processed your withdrawal request. Below are the transaction details:
                </p>

                <table width="100%" cellpadding="8" cellspacing="0" border="0" style="background-color:#f8f9fb; border-radius:6px; margin-top:10px;">
                  <tr>
                    <td style="font-weight:600; width:170px;">Requested Amount:</td>
                    <td>₦{{requestedAmount}}</td>
                  </tr>
                  <tr>
                    <td style="font-weight:600;">Service Fee ({{feePercent}}%):</td>
                    <td>₦{{feeAmount}}</td>
                  </tr>
                  <tr>
                    <td style="font-weight:600;">Amount Sent:</td>
                    <td><strong>₦{{netAmount}}</strong></td>
                  </tr>
                 
                
                  <tr>
                    <td style="font-weight:600;">Date:</td>
                    <td>{{date}}</td>
                  </tr>
                </table>

                <p style="margin:18px 0 0 0;">
                  Please confirm once you receive the funds. If you do not receive the money within 24 hours,
                  or if you have any questions, reply to this email or contact our support team at
                  <a href="mailto:{{supportEmail}}" style="color:#0b3d91; text-decoration:none;">{{supportEmail}}</a>.
                </p>

                <p style="margin:16px 0 0 0; color:#666; font-size:13px;">
                  Note: We deduct a {{feePercent}}% service fee from withdrawal requests to cover processing and maintenance costs.
                </p>
              </td>
            </tr>
            
            <!-- Footer -->
            <tr>
              <td align="center" bgcolor="#f5f5f5" style="color:#888888; font-size:12px; padding:14px;">
                &copy; {{year}} {{companyName}}. All rights reserved.
              </td>
            </tr>

          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
